# ── Blizzard OAuth (consumed by @denipetrov/blizz-auth) ───────────────────────
# Create a client at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# OAuth host region used to mint the token: us | eu | kr | tw | cn.
# Independent of BLIZZARD_REGIONS below, which lists the ladders to ingest.
BLIZZARD_REGION=us

# ── Blizzard Game Data API ────────────────────────────────────────────────────
# Regions to ingest (comma separated): us,eu,kr,tw
BLIZZARD_REGIONS=us,eu,kr,tw
BLIZZARD_LOCALE=en_US
# Host template; {region} is substituted per call. Override only to point the
# service at a fake server for a runtime rehearsal.
# BLIZZARD_API_HOST_TEMPLATE=https://{region}.api.blizzard.com
BLIZZARD_REQUEST_TIMEOUT_MS=30000
BLIZZARD_RETRY_LIMIT=3
# Retries for the per-character profile endpoints. Lower than the above on
# purpose: enrichment is one request per character per half, so at the defaults
# it is 12,000 requests an hour before a single retry, against a 36,000 quota.
PROFILE_RETRY_LIMIT=1
# Max leaderboard requests in flight across all regions/brackets
BLIZZARD_CONCURRENCY=8

# ── Profile enrichment (race, class, spec, hero talents) ─────────────────────
# Two API requests per character, so this runs as its own budgeted background
# pass. Blizzard allows 100 req/s and 36,000 req/hour across everything.
PROFILE_ENRICHMENT_ENABLED=true
PROFILE_INTERVAL_MS=300000
# Characters per pass (each costs 2 requests)
# Ceiling on characters per run, not the working batch: the batch is computed
# each run from what is due and what the quota share allows. At 500 this was the
# binding limit and capped the population at ~144k — right at the live size.
PROFILE_BATCH_SIZE=2000
# The two profile endpoints are refreshed independently to save quota.
# Summary (race, class, realm, title) changes rarely — 7 days.
PROFILE_SUMMARY_TTL_MS=604800000
# Specializations (spec, hero talents) follow respecs — 1 day.
PROFILE_SPECS_TTL_MS=86400000
PROFILE_CONCURRENCY=8
# How long a character waits after a transient enrichment failure before it is
# eligible again. Non-zero matters: a character that is never stamped sorts
# ahead of everything forever and starves the queue.
PROFILE_RETRY_BACKOFF_MS=900000
PROFILE_REQUESTS_PER_SECOND=20

# ── Seasons ──────────────────────────────────────────────────────────────────
# How often to re-check the active season, so a rollover is caught at runtime
# rather than only on restart (1 day)
SEASON_REFRESH_INTERVAL_MS=86400000

# Retiring a finished season from the live collections. The trigger is the NEXT
# season starting, so a finished season stays readable through the gap.
SEASON_TRANSITION_ENABLED=true
SEASON_TRANSITION_CHECK_INTERVAL_MS=3600000
# Only purge a season the archive already holds in full - after a purge the
# archive is the only surviving copy.
SEASON_PURGE_REQUIRE_ARCHIVE=true
# Log the full plan and delete nothing. Defaults to true, because on a first
# deploy mid-season the purge gate is ALREADY open. Read the plan, then set
# this to false to arm the purge.
SEASON_PURGE_DRY_RUN=true

# ── Archive of finished seasons ──────────────────────────────────────────────
# Historical standings never change, so each season is fetched once. Only
# leaderboard data is kept — no profile enrichment.
ARCHIVE_ENABLED=true
ARCHIVE_CHECK_INTERVAL_MS=3600000
ARCHIVE_SEASON_PAUSE_MS=5000
ARCHIVE_CONCURRENCY=4
# Top N by rating kept per bracket (Blizzard already returns about this many)
ARCHIVE_MAX_ENTRIES_PER_BRACKET=5000
# Oldest season to archive; 0 = everything Blizzard still serves (~20M rows / 5GB).
# Seasons 35+ are the ones with per-spec shuffle ladders.
ARCHIVE_MIN_SEASON=0
# Newest season to archive; 0 = no upper bound
ARCHIVE_MAX_SEASON=0
ARCHIVE_REQUESTS_PER_SECOND=10

# ── Spec representation ("flavour of the month") ─────────────────────────────
# One snapshot per UTC day per region/bracket/cutoff, for as long as a season runs.
REPRESENTATION_ENABLED=true
REPRESENTATION_CHECK_INTERVAL_MS=3600000
# Rating cutoffs to track
REPRESENTATION_MIN_RATINGS=1500,1800,2100,2300,2700

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=rankwarden

# ── Ingestion ─────────────────────────────────────────────────────────────────
# How often the full leaderboard sweep re-runs
INGEST_INTERVAL_MS=3600000
# Run a sweep immediately on application startup
INGEST_RUN_ON_STARTUP=true

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# ── Shared Blizzard quota ────────────────────────────────────────────────────
# One hourly budget every job draws from, counted from real requests (retries
# included). The sweep is never throttled; enrichment plans at most
# QUOTA_HOURLY_LIMIT / QUOTA_ENRICHMENT_HEADROOM; the archive gets what is left.
QUOTA_HOURLY_LIMIT=36000
# Fraction of the cap ever planned against; the rest absorbs in-flight requests.
QUOTA_UTILISATION=0.9
QUOTA_ENRICHMENT_HEADROOM=3
# Requests an hour held back for the sweep before anything else may spend.
QUOTA_SWEEP_RESERVE=1000

# ── Raider.IO API (the Mythic+ upstream) ─────────────────────────────────────
# Metered separately from Blizzard: its own budget, its own health, its own
# rate limiter. A Raider.IO request is never charged to the Blizzard quota.
# Key from https://raider.io/settings/apps — required when MPLUS_ENABLED=true.
RAIDER_IO_API_KEY=
# Base url. Override only to point at a fake server for a rehearsal.
# RAIDERIO_API_BASE_URL=https://raider.io/api/v1
# Regions to ingest M+ runs for. Includes cn, which Blizzard's global API does
# not serve. "world" is rejected: it is the union of the others, so ingesting it
# alongside them would store every run twice.
RAIDERIO_REGIONS=us,eu,kr,tw,cn
# Season slug, e.g. season-mn-2. Empty means "ask Raider.IO", which is the
# default on purpose: pinned, the service goes on fetching a frozen ladder after
# a rollover while reporting every pass as a success.
RAIDERIO_SEASON=
RAIDERIO_SEASON_TTL_MS=86400000
RAIDERIO_REQUEST_TIMEOUT_MS=30000
RAIDERIO_RETRY_LIMIT=2
# Pages fetched in parallel. Measured ~0.65s a page, so 12 is ~18 pages/second.
RAIDERIO_CONCURRENCY=12
# Pages per batch: how much is held before a write, and how often the per-minute
# budget and the job priority are re-consulted during a minutes-long pass.
RAIDERIO_PAGE_BATCH=50
# Pages per region per pass, counted from zero. The endpoint refuses page > 1000,
# so 1001 is the whole leaderboard — 20,020 runs. Lowering it trades mythicScore
# completeness for time.
RAIDERIO_MAX_PAGES=1001
# Raider.IO's cap in requests a minute, across the whole client. Their docs state
# 200/minute unauthenticated and lift it for registered applications; no
# rate-limit header is exposed on a success, so this is configuration rather than
# something readable from a response. Lower it if 429s appear.
RAIDERIO_MINUTE_LIMIT=1000
# Fraction of the cap ever planned against; the rest absorbs in-flight requests.
RAIDERIO_UTILISATION=0.9
# Token bucket, kept under RAIDERIO_MINUTE_LIMIT x RAIDERIO_UTILISATION / 60 so a
# burst at the start of a minute cannot spend the window before the budget notices.
RAIDERIO_REQUESTS_PER_SECOND=14

# ── Mythic+ ingestion ────────────────────────────────────────────────────────
# Off by default, unlike every other job: it is the only one needing a credential
# the service did not previously have, so a default of on would stop an existing
# deployment from booting the moment it took this build.
MPLUS_ENABLED=false
# A pass is ~1,001 requests a region; at five regions that is ~5,005 per pass and
# ~20,000 a day at six hours. The interval is chosen for how fast the ladder moves
# and how much Mongo churn is reasonable, not for the quota.
MPLUS_INTERVAL_MS=21600000

