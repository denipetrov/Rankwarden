# Production configuration for the Rankwarden service — everything that is NOT a secret.
#
# The chart turns this file into the ConfigMap (see templates/_helpers.tpl), and CI
# validates it against the service's own schema before any deploy. What each variable
# means is documented once, in .env.example; a comment here says only why a production
# value differs from the development one.
#
# Never put a credential in this file. The four secret variables — BLIZZARD_CLIENT_ID,
# BLIZZARD_CLIENT_SECRET, RAIDER_IO_API_KEY and MONGODB_URI — live in a Kubernetes
# Secret created by deploy/scripts/create-secrets.sh, and the chart refuses to render if
# one of them appears here.

# ── Blizzard API ──────────────────────────────────────────────────────────────
BLIZZARD_REGION=us
BLIZZARD_REGIONS=us,eu,kr,tw
BLIZZARD_LOCALE=en_US
BLIZZARD_REQUEST_TIMEOUT_MS=30000
BLIZZARD_RETRY_LIMIT=3
BLIZZARD_CONCURRENCY=8

# ── Profile enrichment ────────────────────────────────────────────────────────
PROFILE_RETRY_LIMIT=1
PROFILE_ENRICHMENT_ENABLED=true
PROFILE_INTERVAL_MS=300000
PROFILE_BATCH_SIZE=2000
PROFILE_SUMMARY_TTL_MS=604800000
PROFILE_SPECS_TTL_MS=86400000
PROFILE_CONCURRENCY=8
PROFILE_RETRY_BACKOFF_MS=900000
PROFILE_REQUESTS_PER_SECOND=20

# ── PvP seasons ───────────────────────────────────────────────────────────────
SEASON_REFRESH_INTERVAL_MS=86400000
SEASON_TRANSITION_ENABLED=true
SEASON_TRANSITION_CHECK_INTERVAL_MS=3600000
SEASON_PURGE_REQUIRE_ARCHIVE=true
# A finished season is really removed from the live collections once its
# successor has started and its archive is complete. The development default
# only logs what it would remove.
#
# This fires on the first check after a start, not only at a rollover. On a
# database that starts empty there is nothing to retire. A first deploy over
# RESTORED data should run once with this overridden to true and the logged
# plan read first — see deploy/README.md.
SEASON_PURGE_DRY_RUN=false
SEASON_REFRESH_ENABLED=true

# ── PvP archive ───────────────────────────────────────────────────────────────
ARCHIVE_ENABLED=true
ARCHIVE_CHECK_INTERVAL_MS=3600000
ARCHIVE_WAIT_FOR_IDLE_MS=1200000
ARCHIVE_SEASON_PAUSE_MS=5000
ARCHIVE_CONCURRENCY=4
ARCHIVE_MAX_ENTRIES_PER_BRACKET=5000
# Blizzard serves seasons 27 and later. 22–26 answer 403 and are not marked
# unarchivable (only a 404 is), so from 0 they would be retried, and logged as
# errors, every hour for good.
ARCHIVE_MIN_SEASON=27
ARCHIVE_MAX_SEASON=0
ARCHIVE_REQUESTS_PER_SECOND=10

# ── Spec representation ───────────────────────────────────────────────────────
REPRESENTATION_ENABLED=true
REPRESENTATION_CHECK_INTERVAL_MS=3600000
REPRESENTATION_MIN_RATINGS=1500,1800,2100,2300,2700

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_DB=rankwarden
MONGODB_SOCKET_TIMEOUT_MS=300000
# The service only checks the database structure and refuses to start if it
# is not there. The schema Job, which runs before every release, builds it.
DB_SCHEMA_MODE=verify

# ── PvP sweep ─────────────────────────────────────────────────────────────────
INGEST_INTERVAL_MS=3600000
INGEST_RUN_ON_STARTUP=true

# ── Process ───────────────────────────────────────────────────────────────────
# Also makes every /admin/* route answer 404.
NODE_ENV=production
PORT=3000
LOG_LEVEL=log

# ── Blizzard quota ────────────────────────────────────────────────────────────
QUOTA_HOURLY_LIMIT=36000
QUOTA_UTILISATION=0.9
QUOTA_ENRICHMENT_HEADROOM=3
QUOTA_SWEEP_RESERVE=1000

# ── Raider.io API ─────────────────────────────────────────────────────────────
RAIDERIO_REGIONS=us,eu,kr,tw,cn
RAIDERIO_REQUEST_TIMEOUT_MS=30000
RAIDERIO_RETRY_LIMIT=2
RAIDERIO_CONCURRENCY=12
RAIDERIO_PAGE_BATCH=50
RAIDERIO_MAX_PAGES=1001
RAIDERIO_MINUTE_LIMIT=1000
RAIDERIO_UTILISATION=0.9
RAIDERIO_REQUESTS_PER_SECOND=14
RAIDERIO_ARCHIVE_SHARE=0.5
RAIDERIO_BUDGET_WAIT_MS=60000

# ── Mythic+ ───────────────────────────────────────────────────────────────────
# On, as in development.
MPLUS_ENABLED=true
MPLUS_INTERVAL_MS=21600000
MPLUS_YIELD_WAIT_MS=600000
# On, as in development.
MPLUS_ARCHIVE_ENABLED=true
MPLUS_ARCHIVE_CHECK_INTERVAL_MS=3600000
MPLUS_ARCHIVE_PAGES=100
MPLUS_CATALOGUE_FIRST_EXPANSION=6
MPLUS_CATALOGUE_TTL_MS=86400000
MPLUS_SEASON_REFRESH_ENABLED=true
MPLUS_SEASON_CHECK_INTERVAL_MS=3600000
MPLUS_TRANSITION_ENABLED=true
MPLUS_TRANSITION_CHECK_INTERVAL_MS=3600000
MPLUS_PURGE_REQUIRE_ARCHIVE=true
MPLUS_PURGE_DRY_RUN=false

# ── Raiding ───────────────────────────────────────────────────────────────────
# Off, as in development: the raid jobs have not been run against live data
# outside the test suite. Set this and RAID_RANKINGS_ENABLED to true to ingest raids.
RAID_CATALOGUE_ENABLED=true
RAID_CATALOGUE_FIRST_EXPANSION=6
RAID_CATALOGUE_TTL_MS=86400000
RAID_CATALOGUE_CHECK_INTERVAL_MS=3600000
RAID_RANKINGS_ENABLED=true
RAID_RANKINGS_REGIONS=world,us,eu,kr,tw
RAID_RANKINGS_DIFFICULTIES=mythic,heroic,normal
RAID_RANKINGS_CONCURRENCY=5
RAID_RANKINGS_INTERVAL_MS=3600000
RAID_RANKINGS_REQUEST_TIMEOUT_MS=75000
